{
  "name": "dsh-sync-hub",
  "version": "0.4.1",
  "private": true,
  "description": "Sync DSH skills, plugin settings, plugin files, sessions and global AGENTS.md to local folders, WebDAV or S3-compatible storage.",
  "icon": "./assets/icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./core": "./lib/core/index.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/zh-cn.json": "./locale/zh-cn.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/core/index.js",
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "install:profile": "node scripts/install-plugin.mjs",
    "backup:test": "node scripts/local-backup-test.mjs",
    "backup:real": "node scripts/real-backup-test.mjs"
  },
  "license": "MIT"
}
